# ==============================================================================
# FaultLens - Environment Configuration Template
# ==============================================================================

# Database Persistence (MySQL 8.0)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/faultlens_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# Authentication & Security
JWT_SECRET=FaultLensSuperSecretSigningKey2026WithMinimum256BitsLengthForHS256Algorithm
JWT_EXPIRATION_MS=86400000

# Microservices Ports
GATEWAY_PORT=8080
EUREKA_PORT=8761
AUTH_SERVICE_PORT=8081
EQUIPMENT_SERVICE_PORT=8082
SENSOR_SERVICE_PORT=8083
MAINTENANCE_SERVICE_PORT=8084

# Python AI Engine Service
PYTHON_AI_PORT=8000
PYTHON_AI_URL=http://localhost:8000

# React Frontend App
VITE_PORT=5173
VITE_API_BASE_URL=/api
