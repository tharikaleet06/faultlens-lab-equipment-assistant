{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: Build All Microservices",
      "type": "shell",
      "command": "mvn clean package -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Full System Script",
      "type": "shell",
      "command": "./start-all.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Start React JS Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
